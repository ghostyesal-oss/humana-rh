# Sans nom de domaine : IP du VPS + HTTP (voir CADDY_ADDRESS).
# Quand le domaine arrive : remplacer par rh.exemple.fr, https, COOKIE_SECURE=true.

HUMANA_DOMAIN=0.0.0.0
APP_ORIGIN=http://0.0.0.0
CADDY_ADDRESS=http://0.0.0.0
COOKIE_SECURE=false

POSTGRES_PASSWORD=changez-moi-un-mot-de-passe-fort
JWT_SECRET=changez-moi-une-chaine-de-plus-de-32-caracteres
# Durée de session (ex. 12h, 1d). Logout incrémente session_epoch (révocation).
JWT_EXPIRES_IN=12h

# Connexion API soumise à la RLS (rôle humana_app). Ne pas réutiliser humana ici.
APP_DATABASE_URL=postgres://humana_app:changez-moi-un-mot-de-passe-fort@postgres:5432/humana

ENTRA_TENANT_ID=common
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=http://0.0.0.0/api/auth/microsoft/callback

# E-mails auto-promus creator à la connexion (liste séparée par des virgules).
# Laisser vide une fois le compte creator créé.
BOOTSTRAP_CREATOR_EMAILS=

# E-mails qui voient les colonnes paie EDS (liste séparée par des virgules).
PAYROLL_EMAILS=

# Sauvegardes Postgres (volume pgbackups, distinct de pgdata).
# Obligatoire (≥ 16 caractères). openssl rand -hex 32
BACKUP_ENCRYPTION_KEY=
BACKUP_KEEP_DAYS=14
BACKUP_INTERVAL_SEC=86400
# Dossier monté dans le conteneur backup pour copier les .enc (pas de shell).
BACKUP_OFFSITE_DIR=

# Supervision (ntfy.sh, Slack incoming webhook, etc.)
ALERT_WEBHOOK_URL=
DISK_WARN_PCT=90
CERT_WARN_DAYS=14
WATCHDOG_INTERVAL_SEC=300

VAPID_PUBLIC_KEY=
