(humana_site) {
	encode gzip

	@https {
		protocol https
	}
	header @https Strict-Transport-Security "max-age=31536000; includeSubDomains"
	header X-Content-Type-Options nosniff
	header X-Frame-Options DENY
	header Referrer-Policy strict-origin-when-cross-origin

	handle /api* {
		reverse_proxy api:3000
	}

	handle {
		root * /srv
		redir /index.html / 301
		@html path_regexp html ^/(.+)\.html$
		redir @html /{re.html.1} 301
		@assets path *.js *.css *.webmanifest *.ico *.mjs
		header @assets Cache-Control "public, max-age=0, must-revalidate"
		try_files {path} {path}.html
		file_server
	}
}

:80 {
	import humana_site
}

{$CADDY_ADDRESS} {
	import humana_site
}
