(humana_site) {
	encode gzip

	@https {
		protocol https
	}
	header @https Strict-Transport-Security "max-age=31536000; includeSubDomains"
	header X-Content-Type-Options nosniff
	header X-Frame-Options DENY
	header Referrer-Policy strict-origin-when-cross-origin

	handle /api* {
		reverse_proxy api:3000
	}

	handle {
		root * /srv
		redir /index.html / 301
		@html path_regexp html ^/(.+)\.html$
		redir @html /{re.html.1} 301
		@hashed {
			path *.js *.css *.mjs *.webmanifest
			query h=*
		}
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@images path *.webp *.png *.jpg *.jpeg *.svg *.woff2
		header @images Cache-Control "public, max-age=31536000, immutable"
		@revalidate {
			not query h=*
			not path *.webp *.png *.jpg *.jpeg *.svg *.woff2
		}
		header @revalidate Cache-Control "no-cache"
		try_files {path} {path}.html
		file_server
	}
}

:80 {
	import humana_site
}

{$CADDY_ADDRESS} {
	import humana_site
}
